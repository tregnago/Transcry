<Window x:Class="Transcry.Views.CompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcription complete"
        Icon="../Assets/Transcry.ico"
        Width="450" Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="#202C47">
  <Grid ClipToBounds="True">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F9FBFF" Offset="0" />
        <GradientStop Color="#EEF3FF" Offset="0.6" />
        <GradientStop Color="#EEF9FA" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-160,-110,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#609DAAFF" Offset="0" />
          <GradientStop Color="#009DAAFF" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Border Margin="20" Padding="22" Background="White" CornerRadius="18"
            BorderBrush="#E1E8F5" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#7584AB" BlurRadius="20" ShadowDepth="5" Opacity="0.12" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Width="46" Height="46" HorizontalAlignment="Left">
          <Ellipse Fill="#E5F6F0" />
          <Path Data="M 12,23 L 20,31 L 35,15" Stroke="#268768"
                StrokeThickness="4" StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
        <TextBlock Grid.Row="1" Text="Transcription complete"
                   FontSize="20" FontWeight="Bold" Margin="0,11,0,0" />
        <TextBlock Grid.Row="2" Text="Your transcript is ready. You can save it as a text file."
                   FontSize="13" Foreground="#66748D" TextWrapping="Wrap"
                   Margin="0,7,0,0" />
        <Button Grid.Row="4" Content="OK" Width="104" Height="38"
                HorizontalAlignment="Right" Margin="0,15,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True" Click="Close_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
