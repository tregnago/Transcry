<Window x:Class="Transcry.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Transcry.Converters"
        Title="Settings"
        Height="280"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
  <Window.Resources>
    <converters:StringNullOrEmptyToVisibilityConverter x:Key="ErrorVisibilityConverter" />
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="OpenAI API key"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <TextBlock Grid.Row="1"
               TextWrapping="Wrap"
               Foreground="#555"
               Margin="0,0,0,16"
               Text="The key is stored locally on this PC and protected with Windows encryption (DPAPI)." />

    <PasswordBox x:Name="ApiKeyBox"
                 Grid.Row="2"
                 Height="36"
                 Padding="8,6"
                 VerticalContentAlignment="Center" />

    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Padding="12"
            Background="#FDECEC"
            BorderBrush="#E57373"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding ErrorMessage, Converter={StaticResource ErrorVisibilityConverter}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 TextWrapping="Wrap"
                 Foreground="#B71C1C" />
    </Border>

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              Width="100"
              Height="36"
              Margin="0,0,8,0"
              IsCancel="True"
              Click="Cancel_Click" />
      <Button Content="Save"
              Width="100"
              Height="36"
              IsDefault="True"
              Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
