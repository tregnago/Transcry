<Window x:Class="Transcry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Transcry.Converters"
        Title="Transcry"
        Height="640"
        Width="900"
        MinHeight="500"
        MinWidth="700"
        Background="#F5F5F5">
  <Window.Resources>
    <converters:BoolToVisibilityConverter x:Key="BusyVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="IdleVisibilityConverter" Invert="True" />
    <converters:StringNullOrEmptyToVisibilityConverter x:Key="ErrorVisibilityConverter" />
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Trascrizione audio con OpenAI Whisper"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="#555"
                 TextWrapping="Wrap"
                 Text="{Binding SupportedFormats, StringFormat=Formati supportati: {0}. I file oltre 25 MB vengono suddivisi automaticamente.}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
               Height="36"
               Padding="8,6"
               VerticalContentAlignment="Center"
               IsReadOnly="True"
               Background="White"
               Text="{Binding SelectedFilePath, Mode=OneWay, TargetNullValue='Nessun file selezionato'}" />

      <Button Grid.Column="1"
              Content="Sfoglia..."
              Width="110"
              Height="36"
              Margin="8,0,0,0"
              Command="{Binding BrowseCommand}" />
    </Grid>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,0,0,12">
      <Button Content="Trascrivere"
              Width="130"
              Height="36"
              Margin="0,0,8,0"
              Command="{Binding TranscribeCommand}" />
      <Button Content="Annulla"
              Width="110"
              Height="36"
              Margin="0,0,8,0"
              Command="{Binding CancelCommand}"
              Visibility="{Binding IsBusy, Converter={StaticResource BusyVisibilityConverter}}" />
      <Button Content="Salva testo..."
              Width="130"
              Height="36"
              Margin="0,0,8,0"
              Command="{Binding SaveCommand}" />
      <Button Content="Impostazioni"
              Width="120"
              Height="36"
              Command="{Binding OpenSettingsCommand}" />
    </StackPanel>

    <Border Grid.Row="3"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="4">
      <Grid>
        <TextBox Text="{Binding TranscriptionText, Mode=OneWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Padding="12"
                 BorderThickness="0"
                 Background="Transparent"
                 IsReadOnly="True"
                 Visibility="{Binding IsBusy, Converter={StaticResource IdleVisibilityConverter}}" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BusyVisibilityConverter}}">
          <ProgressBar IsIndeterminate="True"
                       Width="220"
                       Height="6"
                       Margin="0,0,0,16" />
          <TextBlock Text="Trascrizione in corso..."
                     HorizontalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <TextBlock Text="Attendi, l'operazione puo richiedere alcuni minuti."
                     HorizontalAlignment="Center"
                     Margin="0,8,0,0"
                     Foreground="#666" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12"
            Background="#FDECEC"
            BorderBrush="#E57373"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding ErrorMessage, Converter={StaticResource ErrorVisibilityConverter}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 TextWrapping="Wrap"
                 Foreground="#B71C1C" />
    </Border>

    <Border Grid.Row="5"
            Margin="0,12,0,0"
            Padding="10,8"
            Background="#E8F4FD"
            BorderBrush="#90CAF9"
            BorderThickness="1"
            CornerRadius="4">
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 Foreground="#1565C0" />
    </Border>
  </Grid>
</Window>
