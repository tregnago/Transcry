<Window x:Class="Transcry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Transcry.Converters"
        Title="Transcry"
        Icon="Assets/Transcry.ico"
        Height="690" Width="960" MinHeight="560" MinWidth="740"
        FontFamily="Segoe UI" Foreground="#202C47">
  <Window.Resources>
    <converters:BoolToVisibilityConverter x:Key="BusyVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="IdleVisibilityConverter" Invert="True" />
    <converters:StringNullOrEmptyToVisibilityConverter x:Key="ErrorVisibilityConverter" />
    <converters:StringNullOrEmptyToVisibilityConverter x:Key="EmptyTranscriptVisibilityConverter" Invert="True" />
  </Window.Resources>
  <Grid ClipToBounds="True">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F9FBFF" Offset="0" />
        <GradientStop Color="#EEF3FF" Offset="0.58" />
        <GradientStop Color="#EEF9FA" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Ellipse Width="660" Height="660" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-370,-260,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#609DAAFF" Offset="0" />
          <GradientStop Color="#009DAAFF" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Margin="-260,0,0,-300" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#42A5EDE6" Offset="0" />
          <GradientStop Color="#00A5EDE6" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Grid Margin="30,24,30,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="Assets/Transcry.png" Width="60" Height="60" />
        <StackPanel Grid.Column="1" Margin="14,1,0,0" VerticalAlignment="Center">
          <TextBlock Text="Transcry" FontSize="27" FontWeight="Bold" />
          <TextBlock Text="Audio transcription with OpenAI Whisper"
                     Foreground="#66748D" FontSize="13" Margin="0,1,0,0" />
        </StackPanel>
        <Border Grid.Column="2" VerticalAlignment="Center" Padding="12,7" CornerRadius="12"
                Background="#E6ECFF" BorderBrush="#D2DCFF" BorderThickness="1">
          <TextBlock Text="AUDIO  →  TEXT" Foreground="#4857B7"
                     FontWeight="SemiBold" FontSize="11" />
        </Border>
      </Grid>
      <Border Grid.Row="1" Margin="0,22,0,16" Padding="22,19"
              Background="White" CornerRadius="18" BorderBrush="#E1E8F5" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#7584AB" BlurRadius="20" ShadowDepth="5" Opacity="0.12" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Choose an audio file" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,14" Foreground="#66748D" FontSize="12" TextWrapping="Wrap"
                     Text="{Binding SupportedFormats, StringFormat=Supported formats: {0}. Files over 25 MB are split automatically.}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Height="40" Padding="11,7" VerticalContentAlignment="Center"
                     IsReadOnly="True" Background="#F8FAFF" BorderBrush="#DEE5F2"
                     Foreground="#40516D" FontSize="13"
                     Text="{Binding SelectedFilePath, Mode=OneWay, TargetNullValue='No file selected'}" />
            <Button Grid.Column="1" Content="Browse..." Width="116" Height="40"
                    Margin="10,0,0,0" Command="{Binding BrowseCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="Transcribe" Width="140" Height="40" Margin="0,0,9,0"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding TranscribeCommand}" />
            <Button Content="Cancel" Width="108" Height="40" Margin="0,0,9,0"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BusyVisibilityConverter}}" />
            <Button Content="Settings" Width="108" Height="40"
                    Command="{Binding OpenSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Padding="21,17,21,18" Background="White" CornerRadius="18"
              BorderBrush="#E1E8F5" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#7584AB" BlurRadius="20" ShadowDepth="5" Opacity="0.1" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Transcript" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Your words, ready to save" Foreground="#7A879B"
                         FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Save text..." Width="124" Height="36"
                    Command="{Binding SaveCommand}" />
          </Grid>
          <Border Grid.Row="1" Background="#FAFBFF" CornerRadius="12"
                  BorderBrush="#E7ECF6" BorderThickness="1">
            <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Visibility="{Binding TranscriptionText, Converter={StaticResource EmptyTranscriptVisibilityConverter}}">
                <TextBlock Text="♪" FontSize="37" Foreground="#A7B3E7"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Your transcript will appear here" FontSize="14"
                           FontWeight="SemiBold" Foreground="#8491AB"
                           HorizontalAlignment="Center" Margin="0,7,0,0" />
              </StackPanel>
              <TextBox Text="{Binding TranscriptionText, Mode=OneWay}" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled" Padding="14"
                       BorderThickness="0" Background="Transparent" Foreground="#263653"
                       FontSize="14" IsReadOnly="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource IdleVisibilityConverter}}" />
              <Border Background="#FAFBFF"
                      Visibility="{Binding IsBusy, Converter={StaticResource BusyVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Ellipse Stroke="#E1E7FA" StrokeThickness="6" />
                    <Path Width="72" Height="72" Stretch="None"
                          Data="M 36,6 A 30,30 0 0 1 66,36"
                          Stroke="#5361D7" StrokeThickness="6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.RenderTransform>
                        <RotateTransform CenterX="36" CenterY="36" />
                      </Path.RenderTransform>
                      <Path.Style>
                        <Style TargetType="Path">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                              <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="WaiterStoryboard">
                                  <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1.1" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </DataTrigger.EnterActions>
                              <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="WaiterStoryboard" />
                              </DataTrigger.ExitActions>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <Image Source="Assets/Transcry.png" Width="32" Height="32" />
                  </Grid>
                  <TextBlock Text="Working on your audio" HorizontalAlignment="Center"
                             FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                             Margin="0,7,0,0" Foreground="#7A879B" FontSize="12" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <Border Margin="0,0,0,10" Padding="13,10" Background="#FFF0F0"
                BorderBrush="#F2C3C5" BorderThickness="1" CornerRadius="10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource ErrorVisibilityConverter}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#AE333D" />
        </Border>
        <Border Padding="13,10" Background="#EAF1FF" BorderBrush="#D5E2FF"
                BorderThickness="1" CornerRadius="10">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#3D5799" />
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
